{
	"name": "n8n-nodes-web-request-markdown",
	"version": "0.1.0",
	"description": "n8n community node that makes HTTP requests and returns the response as clean Markdown instead of raw HTML",
	"license": "MIT",
	"homepage": "https://github.com/dkhalife/n8n-web-request-markdown",
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "dkhalife",
		"url": "https://github.com/dkhalife"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/dkhalife/n8n-web-request-markdown.git"
	},
	"scripts": {
		"build": "tsc && gulp build:icons",
		"dev": "tsc --watch",
		"lint": "eslint nodes/ credentials/ --ext .ts",
		"lint:fix": "eslint nodes/ credentials/ --ext .ts --fix",
		"prepublishOnly": "npm run build"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [],
		"nodes": [
			"dist/nodes/WebRequestMarkdown/WebRequestMarkdown.node.js"
		]
	},
	"devDependencies": {
		"@types/turndown": "^5.0.5",
		"eslint": "^8.56.0",
		"gulp": "^5.0.1",
		"n8n-workflow": "*",
		"prettier": "^3.2.0",
		"typescript": "^5.3.0"
	},
	"dependencies": {
		"cheerio": "^1.0.0",
		"turndown": "^7.2.0",
		"turndown-plugin-gfm": "^1.0.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
